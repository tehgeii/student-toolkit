<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing goes to Google's cloud backup. Moving to a new phone with a cable or
    Wi-Fi device transfer still copies the app's data, so nothing is lost when switching phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
